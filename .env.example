DATABASE_URL=postgresql://swiss:swiss@localhost:5433/swiss_grounding
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
GEOADMIN_BASE_URL=https://api3.geo.admin.ch
LLM_BACKEND=fake
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
CRAWL_MAX_PAGES=200
FETCH_RETRY_ATTEMPTS=3
FETCH_RETRY_BACKOFF_SECONDS=0.5

# Encoding track. The API key (OpenAI or Anthropic) is needed only while ingesting: it pays for OCR and
# descriptions, and for embeddings only when a paid index is in CORPUS_INDEXES.
# OPENAI_API_KEY=
CORPUS_LLM_PROVIDER=fake
# Embedding indexes to build, comma-separated. bge-m3 is local and free (the server answers from it).
# Add openai-3l (e.g. CORPUS_INDEXES=bge-m3,openai-3l) only to also pay for the OpenAI index; it needs OPENAI_API_KEY.
CORPUS_INDEXES=bge-m3
CORPUS_BUDGET_USD=100
CORPUS_OCR_BUDGET_USD=10
RESPECT_ROBOTS=true
DATA_DIR=data

# Swiss Parliament tools from the zbern.ch MCP server (ADR 0018). Off while ZBERN_MCP_URL is unset.
# ZBERN_MCP_URL=https://mcp.zbern.ch/mcp
# ZBERN_MCP_TOKEN=
# ZBERN_MCP_EXCLUDE=query,list_tables,describe_table
