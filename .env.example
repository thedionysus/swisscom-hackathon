DATABASE_URL=postgresql://swiss:swiss@localhost:5433/swiss_grounding
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
GEOADMIN_BASE_URL=https://api3.geo.admin.ch
LLM_BACKEND=fake
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
CRAWL_MAX_PAGES=200
FETCH_RETRY_ATTEMPTS=3
FETCH_RETRY_BACKOFF_SECONDS=0.5

# Encoding track. The API key (OpenAI or Anthropic) is needed only while ingesting: it pays for OCR and
# descriptions, and for embeddings only when a paid index is in CORPUS_INDEXES.
# OPENAI_API_KEY=
CORPUS_LLM_PROVIDER=fake
# Embedding indexes to build, comma-separated. bge-m3 is local and free (the server answers from it).
# Add openai-3l (e.g. CORPUS_INDEXES=bge-m3,openai-3l) only to also pay for the OpenAI index; it needs OPENAI_API_KEY.
CORPUS_INDEXES=bge-m3
CORPUS_BUDGET_USD=100
CORPUS_OCR_BUDGET_USD=10
RESPECT_ROBOTS=true
DATA_DIR=data

# Swiss Parliament tools from the hosted zbern.ch MCP server. On as soon as the token below is present.
# ZBERN_MCP_TOKEN=                # written by `swiss-grounding setup` from the private release; never commit it
# ZBERN_MCP_URL=https://mcp.zbern.ch/mcp   # the default; set it empty to turn the zbern tools off
# ZBERN_MCP_EXCLUDE=query,list_tables,describe_table,get_reference   # the default; set it empty to serve them too

# Serving: translation (ADR 0018). With the key set, every swiss_search translates the question into the
# other language stores before searching and cited passages back into the question's language.
# Without it nothing is translated and the server behaves as before. Costs Supertext credit per call.
# SUPERTEXT_API_KEY=            # written by `swiss-grounding setup` from the private release; never commit it
# TRANSLATE_QUERY_LANGUAGES=de,fr,it,en    # add rm only after checking the reranker on Romansh pages (config.py)
# TRANSLATE_CITATIONS=true
