# Copy to .env. Every setting is described in the README's Configuration section.

# The Docker database (docker-compose.yml).
DATABASE_URL=postgresql://swiss:swiss@localhost:5433/swiss_grounding

# ---- Running the server ----
# Required: every question is embedded with OpenAI's text-embedding-3-large (the database has only OpenAI vectors).
# OPENAI_API_KEY=sk-...
# Written by `swiss-grounding setup` from the private release; never commit them.
# SUPERTEXT_API_KEY=              # translate questions and cited passages; costs Supertext credit per search
# ZBERN_MCP_TOKEN=                # turns on the zbern_* parliament tools
# TRANSLATE_QUERY_LANGUAGES=de,fr,it,en
# TRANSLATE_CITATIONS=true
# ZBERN_MCP_URL=https://mcp.zbern.ch/mcp                            # set it empty to turn the zbern tools off
# ZBERN_MCP_EXCLUDE=query,list_tables,describe_table,get_reference  # set it empty to serve them too
# HF_HUB_OFFLINE is read from the environment only, not from this file: export it where the server starts.

# ---- Building the corpus (see docs/MAINTAINING.md) ----
# OPENAI_API_KEY (above) also pays for OCR and descriptions, and for OpenAI embeddings when openai-3l is in CORPUS_INDEXES.
CORPUS_LLM_PROVIDER=fake          # openai, anthropic or apertus; fake is for tests and refuses to write real data
# ANTHROPIC_API_KEY=
# APERTUS_API_KEY=                # Apertus on Swisscom's Swiss AI Platform; used by any *=apertus setting
# APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
# APERTUS_WORKERS=3                # parallel direct calls, sized under the 5 requests/s limit
# APERTUS_TIMEOUT_SECONDS=60
# EVAL_LLM_PROVIDER=openai        # openai, anthropic or apertus: eval labels and generated questions
# TRANSLATOR=supertext            # supertext, apertus or none
CORPUS_BUDGET_USD=100             # hard cap across every paid stage: set it to the credit you have
CORPUS_OCR_BUDGET_USD=10
CORPUS_INDEXES=bge-m3             # add openai-3l (bge-m3,openai-3l) to also pay for the OpenAI index
EMBEDDING_BACKEND=fake            # set to sentence_transformers to build the local bge-m3 index
RESPECT_ROBOTS=true               # obey robots.txt; keep on unless a source's terms were checked
ROBOTS_API_EXCEPTIONS=false       # opt-in: fetch a json source's documented API despite robots.txt where its
                                  # manifest entry gives a robots_exception_reason; each request is logged
DATA_DIR=data
# CRAWL_DELAY_SECONDS=0.5         # minimum delay between requests to one host
# CORPUS_CHAT_TOKENS_PER_FILE=2000000    # Batch API input tokens per file: the account's enqueued-token limit
# CORPUS_EMBED_TOKENS_PER_FILE=2000000
# CORPUS_DIRECT_WORKERS=0         # direct calls beside the Batch API while describing; twice the batch price
